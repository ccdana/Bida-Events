# Lo que no entra al contexto de construcción de la imagen de producción (Dockerfile).
# Queda fuera lo que se reinstala o se recompila dentro de la imagen (dependencias y assets) y lo
# que no tiene por qué viajar a un servidor.

# Control de versiones y automatizaciones
.git
.gitattributes
.gitignore
.github
.claude

# Se reinstalan o se recompilan dentro de la imagen
node_modules
vendor
public/build
public/hot
public/storage
public/_preview

# Lo que escribe la aplicación (el contenedor lo crea vacío o va en un volumen)
storage/app
storage/framework
storage/logs
storage/pail
*.log

# Secretos: la configuración llega por env_file, nunca en la imagen. Los certificados se montan
# como volumen en el contenedor «web».
.env
.env.*
docker/nginx/certs

# Pruebas, documentación y herramientas de desarrollo
tests
docs
scripts
*.md
phpunit.xml
.phpunit.result.cache
.phpunit.cache
.editorconfig
