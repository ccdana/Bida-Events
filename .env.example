# ════════════════════════════════════════════════════════════════════════════
#  Bida Events — variables de entorno
#
#  Esta plantilla viene lista para PRODUCCIÓN. Para trabajar en local cambia lo
#  marcado con «Local:». Nunca subas el .env real al repositorio.
#
#  Al desplegar:
#    1. cp .env.example .env  y completa lo que está vacío
#    2. php artisan key:generate
#    3. php artisan migrate --force
#    4. php artisan config:cache && php artisan route:cache && php artisan view:cache
#    5. npm ci && npm run build
#    6. Programa «php artisan schedule:run» cada minuto y deja corriendo
#       «php artisan queue:work» (exportaciones en PDF/Excel).
# ════════════════════════════════════════════════════════════════════════════

# ── Aplicación ──────────────────────────────────────────────────────────────
APP_NAME="Bida Events"
# Local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://bida-events.test
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://bida-events.com
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Registros ───────────────────────────────────────────────────────────────
# Un archivo por día en storage/logs. Local: LOG_LEVEL=debug
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
# Con Docker no hace falta tocarlos: en desarrollo, docker/entrypoint.sh los reescribe apuntando
# al servicio «pgsql»; en producción, compose.prod.yaml los manda como variables de entorno (ahí
# sí se usan DB_DATABASE, DB_USERNAME y DB_PASSWORD de este archivo, para crear la base).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bida_events
DB_USERNAME=
DB_PASSWORD=

# ── Sesión ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Solo por HTTPS. Local (http): SESSION_SECURE_COOKIE=false o no podrás iniciar sesión
SESSION_SECURE_COOKIE=true

# ── Caché, colas y archivos ─────────────────────────────────────────────────
# Con Redis instalado conviene CACHE_STORE=redis (candados compartidos entre instancias)
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo (avisos de operación) ────────────────────────────────────────────
# Local: MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hola@bida-events.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Cloudinary (fotos, música y video de las invitaciones) ──────────────────
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME. Vacío = se guarda en el disco local.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=bida-events
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_NOTIFICATION_URL=

# ── Datos públicos de la marca (config/bida.php) ────────────────────────────
BIDA_BRAND="Bida Events"
BIDA_CITY="Bolivia"
# Número con código de país, sin «+» ni espacios
BIDA_WHATSAPP=59160385990
BIDA_EMAIL=hola@bida-events.com
# Datos de la empresa para las páginas legales (privacidad, términos). Vacíos: se muestra la marca.
BIDA_LEGAL_NAME=
BIDA_LEGAL_NIT=
BIDA_INSTAGRAM=bidaevents
BIDA_TIKTOK=bidaevents
BIDA_FACEBOOK=bidaevents
# Invitación activa que se ve en el teléfono de la portada
BIDA_DEMO_SLUG=xv-isabella

# ── Ofertas ─────────────────────────────────────────────────────────────────
# Valores con los que arranca el sitio: después se manejan desde el panel
# (Ajustes), que los pisa sin tocar este archivo.
# Los precios van en dólares (US$): moneda y tasa de referencia en config/bida.php, clave «currency».
# Promoción de inauguración en los paquetes (precio normal tachado)
BIDA_LAUNCH_PROMO=true
# Hasta cuándo dura esa promoción (vacío: hasta que se apague)
BIDA_LAUNCH_PROMO_ENDS_AT=
# Hasta cuándo se vende cada temporada (hora de La Paz); son independientes y también se
# cambian (junto con encenderlas o apagarlas) en Ajustes. Pasada la fecha, su botón de la portada desaparece.
BIDA_SEASON_AMOR_ENDS_AT="2026-09-21 23:59:59"
BIDA_SEASON_HALLOWEEN_ENDS_AT="2026-10-31 23:59:59"

# ── Seguridad ───────────────────────────────────────────────────────────────
# Proxies de confianza separados por coma (IP del balanceador o «*» detrás de Cloudflare/Nginx).
TRUSTED_PROXIES=
# Política de contenido: con CSP_ENFORCE=false solo informa; true bloquea lo no permitido
CSP_ENABLED=true
CSP_ENFORCE=false

# Intentos por minuto antes de frenar (config/optimizations.php)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_RSVP=10
RATE_LIMIT_SONGS=10
RATE_LIMIT_PHOTOS=10
RATE_LIMIT_VOTES=30
RATE_LIMIT_REPLIES=5

# ── Rendimiento ─────────────────────────────────────────────────────────────
# Caché de invitaciones en el servidor: se borra sola al guardar desde el editor. Local: false
CACHE_OPTIMIZATIONS_ENABLED=true
INVITATION_CACHE_TTL=3600
# Caché HTTP en el navegador del invitado: déjalo en false, si no los cambios tardan
# hasta 5 minutos en verse después de guardar
HTTP_CACHE_ENABLED=false

# ── Retención de datos ──────────────────────────────────────────────────────
# Días que se conservan las fotos del fotomural y los archivos exportados
RETENTION_PHOTOS_DAYS=180
RETENTION_EXPORTS_DAYS=7

# ── Operación y respaldos (config/operations.php, docs/operacion.md) ────────
SLOW_REQUEST_MS=1500
OPERATIONS_ALERT_EMAIL=
ALERT_FAILED_JOBS=1
ALERT_PENDING_JOB_MINUTES=30
ALERT_BACKUP_MAX_AGE_HOURS=26
ALERT_MIN_FREE_DISK_PERCENT=10

BACKUP_PATH=backups
BACKUP_KEEP_DAYS=14
BACKUP_TIMEOUT=900
# Rutas de los ejecutables si no están en el PATH
# (Laragon: C:/laragon/bin/postgresql/pgsql/bin/pg_dump.exe)
BACKUP_PG_DUMP=pg_dump
BACKUP_PSQL=psql
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

# ── Datos de prueba (solo local) ────────────────────────────────────────────
# database/seeders/ClientUserSeeder.php no corre en producción salvo SEED_CLIENT_IN_PRODUCTION=true.
# Sin contraseña, se genera una y se muestra una sola vez.
SEED_CLIENT_PASSWORD=
SEED_CLIENT_INVITATION=cumple-daniela-30

# ── Docker (docs/docker.md) ─────────────────────────────────────────────────
# Desarrollo (compose.yaml): puertos del equipo y credenciales del contenedor de PostgreSQL.
# Cambiar DOCKER_DB_* obliga a borrar el volumen con «docker compose down -v».
APP_PORT=8000
VITE_PORT=5173
DB_FORWARD_PORT=5432
DOCKER_DB_NAME=bida_events
DOCKER_DB_USER=bida
DOCKER_DB_PASSWORD=secret
# Solo en Linux, si tu usuario no es el 1000 (id -u / id -g)
UID=1000
GID=1000
# Producción (compose.prod.yaml): usa DB_DATABASE, DB_USERNAME y DB_PASSWORD de arriba, y APP_PORT
# como puerto del servidor (detrás va Cloudflare o el Nginx del sistema poniendo el HTTPS).
# BIDA_MIGRATE=0 si prefieres correr las migraciones a mano antes de levantar.
BIDA_MIGRATE=1

VITE_APP_NAME="${APP_NAME}"
