# ════════════════════════════════════════════════════════════════════════════
#  Bida Events — variables de entorno
#
#  Plantilla del servidor de producción (Docker, compose.prod.yaml). Para trabajar
#  en Laragon cambia lo marcado con «Local:». Nunca subas el .env real a git.
#
#  Paso a paso del despliegue: docs/despliegue.md. Correo, Google y pagos: docs/conexiones/.
#
#  compose.prod.yaml fija por su cuenta APP_ENV, APP_DEBUG, DB_CONNECTION, DB_HOST,
#  DB_PORT, REDIS_HOST, REDIS_PORT, CACHE_STORE y QUEUE_CONNECTION: en el servidor
#  lo que diga este archivo para esas claves no se usa.
# ════════════════════════════════════════════════════════════════════════════

# ── Aplicación ──────────────────────────────────────────────────────────────
APP_NAME="Bida Events"
# Local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://bida-events.test
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (una sola vez; cambiarla cierra todas las sesiones)
APP_KEY=
APP_URL=https://bida-events.com
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ── Registros ───────────────────────────────────────────────────────────────
# Un archivo por día en storage/logs, LOG_DAILY_DAYS días. Local: LOG_STACK=single, LOG_LEVEL=debug
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos (PostgreSQL 17) ───────────────────────────────────────────
# En el servidor, DB_DATABASE, DB_USERNAME y DB_PASSWORD también crean la base del contenedor
# «pgsql» la primera vez: cambiarlos después no cambia la base que ya existe.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bida_events
DB_USERNAME=bida
DB_PASSWORD=

# ── Sesión ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Solo por HTTPS. Local (http): SESSION_SECURE_COOKIE=false o no podrás iniciar sesión
SESSION_SECURE_COOKIE=true

# ── Caché, cola y archivos ──────────────────────────────────────────────────
# Local: CACHE_STORE=database (en el servidor es Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo (Zoho Mail por SMTP; docs/conexiones/01-zoho-mail.md) ─────────────────
# Confirmar el correo, crear una contraseña nueva y las alertas de bida:salud.
# Local: MAIL_MAILER=log (o Mailpit de Laragon: MAIL_HOST=127.0.0.1, MAIL_PORT=1025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Tiene que ser la casilla de MAIL_USERNAME o un alias suyo (Zoho rechaza otro remitente)
MAIL_FROM_ADDRESS="hola@bida-events.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Cuentas ─────────────────────────────────────────────────────────────────
# Abrir cuentas desde el sitio (/registro y Google). Con false solo entran las que ya existen.
AUTH_REGISTRATION=true
# Entrar con Google: Google Cloud › APIs y servicios › Credenciales › ID de cliente OAuth (web).
# URI de redirección autorizada: APP_URL/auth/google/callback (docs/conexiones/02-google-oauth.md). Vacíos: el botón no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Pagos en línea (config/payments.php; docs/conexiones/03-lemon-squeezy.md y 04-libelula.md) ───
# Con false los botones de compra van a WhatsApp y el administrador registra los pagos a mano.
PAYMENTS_ENABLED=true
PAYMENTS_CARD_PROVIDER=lemonsqueezy
PAYMENTS_QR_PROVIDER=libelula
# Días después del vencimiento en que todavía se puede crear y editar (0 = se bloquea ese día)
PAYMENTS_GRACE_DAYS=3
# Descuento (%) por pagar 3 o 12 meses de una vez (también se cambia en Ajustes)
PAYMENTS_PREPAY_3_DISCOUNT=10
PAYMENTS_PREPAY_12_DISCOUNT=20

# Lemon Squeezy (tarjeta internacional, USD)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
# true mientras se prueba con tarjetas de prueba (y con la API key de prueba)
LEMONSQUEEZY_TEST_MODE=false
# Id de la variante de cada plan y ciclo. Un ciclo sin variante no se ofrece con tarjeta.
LEMONSQUEEZY_VARIANT_INICIAL=
LEMONSQUEEZY_VARIANT_INICIAL_TRIMESTRAL=
LEMONSQUEEZY_VARIANT_INICIAL_ANUAL=
LEMONSQUEEZY_VARIANT_EMPRENDEDOR=
LEMONSQUEEZY_VARIANT_EMPRENDEDOR_TRIMESTRAL=
LEMONSQUEEZY_VARIANT_EMPRENDEDOR_ANUAL=
LEMONSQUEEZY_VARIANT_AGENCIA=
LEMONSQUEEZY_VARIANT_AGENCIA_TRIMESTRAL=
LEMONSQUEEZY_VARIANT_AGENCIA_ANUAL=
# «Hazlo tú»: producto de pago único «Invitación» (el precio va en cada checkout)
LEMONSQUEEZY_VARIANT_INVITACION=

# Libélula (QR de cualquier banco, Tigo Money y tarjetas bolivianas; BOB)
LIBELULA_APPKEY=
# Producción: https://api.todotix.com · Pruebas: http://www.todotix.com:10888
LIBELULA_BASE_URL=https://api.todotix.com
# Que Libélula emita la factura de cada pago (requiere la facturación configurada con ellos)
LIBELULA_EMITE_FACTURA=false

# ── Cloudinary (fotos, música y video) ──────────────────────────────────────
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME. Vacío: se guarda en el disco (volumen storage).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=bida-events

# ── Marca y datos públicos (config/bida.php) ────────────────────────────────
BIDA_BRAND="Bida Events"
BIDA_CITY="Bolivia"
# Número con código de país, sin «+» ni espacios
BIDA_WHATSAPP=59160385990
BIDA_EMAIL=hola@bida-events.com
BIDA_INSTAGRAM=bidaevents
BIDA_TIKTOK=bidaevents
BIDA_FACEBOOK=bidaevents
# Razón social y NIT para las páginas legales. Vacíos: se muestra la marca.
BIDA_LEGAL_NAME=
BIDA_LEGAL_NIT=
# Invitación que se ve en el teléfono de la portada
BIDA_DEMO_SLUG=xv-isabella
# Borradores de «Hazlo tú» que puede tener abiertos cada cuenta
BIDA_DIY_DRAFTS_LIMIT=3

# ── Ofertas: valores de arranque (después se manejan en Ajustes, que los pisa) ─
# Promoción de inauguración en los paquetes (precio normal tachado) y hasta cuándo (vacío: sin fin)
BIDA_LAUNCH_PROMO=true
BIDA_LAUNCH_PROMO_ENDS_AT=
# Hasta cuándo se vende cada temporada (hora de La Paz)
BIDA_SEASON_AMOR_ENDS_AT="2026-09-21 23:59:59"
BIDA_SEASON_HALLOWEEN_ENDS_AT="2026-10-31 23:59:59"

# ── Seguridad ───────────────────────────────────────────────────────────────
# Proxies de confianza separados por coma. En el servidor Nginx ya toma la IP real de Cloudflare:
# déjalo vacío. Local con un túnel https (ngrok): 127.0.0.1
TRUSTED_PROXIES=
# Política de contenido: con CSP_ENFORCE=false solo informa; true bloquea lo no permitido
CSP_ENABLED=true
CSP_ENFORCE=false

# Intentos por minuto antes de frenar (config/optimizations.php)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_EMAIL=5
RATE_LIMIT_RSVP=10
RATE_LIMIT_SONGS=10
RATE_LIMIT_PHOTOS=10
RATE_LIMIT_VOTES=30
RATE_LIMIT_REPLIES=5
RATE_LIMIT_DOOR=90

# ── Rendimiento ─────────────────────────────────────────────────────────────
# Caché de invitaciones en el servidor: se borra sola al guardar desde el editor. Local: false
CACHE_OPTIMIZATIONS_ENABLED=true
INVITATION_CACHE_TTL=3600
# Caché HTTP en el navegador del invitado: con true los cambios tardan hasta 5 minutos en verse
HTTP_CACHE_ENABLED=false

# ── Retención de datos ──────────────────────────────────────────────────────
# Días que se conservan las fotos del fotomural y los archivos exportados
RETENTION_PHOTOS_DAYS=180
RETENTION_EXPORTS_DAYS=7

# ── Operación y respaldos (config/operations.php, docs/operacion.md) ────────
SLOW_REQUEST_MS=1500
# A quién le llegan las alertas de bida:salud (vacío: solo quedan en el log)
OPERATIONS_ALERT_EMAIL=
ALERT_FAILED_JOBS=1
ALERT_PENDING_JOB_MINUTES=30
ALERT_BACKUP_MAX_AGE_HOURS=26
ALERT_MIN_FREE_DISK_PERCENT=10

BACKUP_PATH=backups
BACKUP_KEEP_DAYS=14
BACKUP_TIMEOUT=900
# Local (Laragon): C:/laragon/bin/postgresql/pgsql/bin/pg_dump.exe y psql.exe
BACKUP_PG_DUMP=pg_dump
BACKUP_PSQL=psql

# ── Docker (compose.prod.yaml) ──────────────────────────────────────────────
# 0 si prefieres correr las migraciones a mano antes de levantar los contenedores
BIDA_MIGRATE=1

# ── Primera instalación ─────────────────────────────────────────────────────
# Contraseña del administrador que crea «php artisan db:seed» fuera de local. Vacía: se genera
# una y se muestra una sola vez en la consola.
SEED_ADMIN_PASSWORD=
