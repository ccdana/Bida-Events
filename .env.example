APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bida_events
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
# En producción (HTTPS) debe ser true; cifra la sesión si se guardan datos sensibles en ella
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# Cloudinary — cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=bida-events

# Datos públicos de la página de inicio (config/bida.php)
BIDA_BRAND="Bida Events"
BIDA_CITY="La Paz, Bolivia"
BIDA_WHATSAPP=59170000000
BIDA_EMAIL=hola@bidaevents.com
BIDA_INSTAGRAM=bidaevents
BIDA_TIKTOK=bidaevents
BIDA_FACEBOOK=bidaevents

# Seguridad: proxies en los que se confía (separados por coma) y política de contenido.
# Vacío = no se confía en ningún proxy. CSP_ENFORCE=true deja de ser solo reporte y bloquea.
TRUSTED_PROXIES=
# Días que se conservan las fotos del fotomural y los archivos exportados
RETENTION_PHOTOS_DAYS=180
RETENTION_EXPORTS_DAYS=7

# Caché de invitaciones: en producción conviene redis (soporta candados compartidos entre instancias)
# CACHE_STORE=redis
CACHE_OPTIMIZATIONS_ENABLED=false
CSP_ENABLED=true
CSP_ENFORCE=false
BIDA_DEMO_SLUG=xv-isabella

# Optimizaciones de cache
CACHE_OPTIMIZATIONS_ENABLED=false
HTTP_CACHE_ENABLED=false

# Cliente de prueba (database/seeders/ClientUserSeeder.php). Sin contraseña, se genera y se muestra una vez.
SEED_CLIENT_PASSWORD=
SEED_CLIENT_INVITATION=cumple-daniela-30

# Operación (config/operations.php, docs/operacion.md)
SLOW_REQUEST_MS=1500
OPERATIONS_ALERT_EMAIL=
BACKUP_KEEP_DAYS=14
# Rutas de los ejecutables si no están en el PATH (en Laragon: C:/laragon/bin/postgresql/pgsql/bin/pg_dump.exe)
BACKUP_PG_DUMP=pg_dump
BACKUP_PSQL=psql
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
